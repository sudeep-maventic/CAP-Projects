  "payment_method": "Credit Card",
  "items": [
    {
      "ID": 5002,
      "product_ID": 1,
      "qty": 1,
      "unitPrice": 1499.00
    },{
        "ID": 5001,
        "product_ID": 1,
        "qty": 3,
        "unitPrice": 1500.00
    }
  ]
}

